# ==============================================================================
# DemandSense Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the services:
#   cp .env.example .env
# ==============================================================================

# General Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="DemandSense"

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=generate_a_secure_random_key_for_production_min_32_chars
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=demandsense
POSTGRES_USER=demandsense_user
POSTGRES_PASSWORD=demandsense_password

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173

# ML & Data Storage Paths
DATA_DIR=data
ARTIFACTS_DIR=ml/artifacts
MODEL_REGISTRY_PATH=ml/models/checkpoints
